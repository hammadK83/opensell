NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000/api/v1
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=opensell
JWT_SECRET=replace-with-a-random-secret
EMAIL_FROM=no-reply@example.invalid
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USER=replace-with-smtp-user
EMAIL_PASS=replace-with-smtp-password
# Generate 32 random bytes and encode as exactly 64 hexadecimal characters.
# Keep this value stable while verification email jobs remain pending.
VERIFICATION_EMAIL_KEY=replace-with-64-hex-characters

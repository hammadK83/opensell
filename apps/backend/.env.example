NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000/api/v1
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=opensell
JWT_SECRET=replace-with-a-random-secret
EMAIL_FROM=no-reply@example.invalid
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USER=replace-with-smtp-user
EMAIL_PASS=replace-with-smtp-password
# Generate 32 random bytes and encode as exactly 64 hexadecimal characters.
# Keep this value stable while verification email jobs remain pending.
VERIFICATION_EMAIL_KEY=replace-with-64-hex-characters

# Set to the exact number of trusted reverse-proxy hops only after the deployment route is known.
# Keep 0 when clients connect directly. The backend must not be reachable around a trusted proxy.
TRUST_PROXY_HOPS=0
# Defaults shown here are optional overrides.
AUTH_RATE_WINDOW_SECONDS=900
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_IP_LIMIT=30
AUTH_REGISTER_IP_LIMIT=5
AUTH_VERIFY_IP_LIMIT=20
AUTH_REFRESH_IP_LIMIT=30
AUTH_RESEND_IP_LIMIT=10
